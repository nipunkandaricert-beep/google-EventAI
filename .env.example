# Optional. Copy to .env.local (never commit real values).

# Recommended for public deployments: a server-side proxy that holds the Gemini key (see proxy/worker.js).
# VITE_GEMINI_PROXY_URL=https://eventai-proxy.<your-subdomain>.workers.dev

